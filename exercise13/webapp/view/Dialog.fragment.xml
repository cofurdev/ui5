<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m" >
    <Dialog 
        id="idDialog"
        title="Info"
        type="Message"
    >
        <content>
            <VBox>
                <Text text="{customer>/Name} 고객님, 가입을 환영합니다." />
                <Text text="{customer>/Age}살이시군요."/>
                <Text text="우편번호: {customer>/Zipcode}" />
                <Text text="주소: {customer>/Address}" />
            </VBox>
        </content>
        <beginButton>
            <Button 
                text="닫기"
                press=".onCloseDialog" />
        </beginButton>
    
    </Dialog>
</core:FragmentDefinition>