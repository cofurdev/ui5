{
  "_version": "1.60.0",
  "sap.app": {
    "id": "code.d3.defect.analysis",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.24.0",
      "toolsId": "31c2955e-99be-49d5-a3a0-5d4b6faa88d7"
    },
    "dataSources": {
      "ZUI_D3_PP_DEFECT_V2_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZUI_D3_PP_DEFECT_V2_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_D3_PP_DEFECT_V2_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_D3_PP_DEFECT_V2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_D3_PP_DEFECT_V2_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "chartService": {
        "uri": "/sap/opu/odata/sap/ZUI_D3_PP_DEFECT2_V2/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      },
      "kpiService": {             
        "uri": "/sap/opu/odata/sap/ZUI_D3_PP_KPI_V2/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      },
      "orderService": {
        "uri": "/sap/opu/odata/sap/ZUI_D3_PP_DEFECT3_V2/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.23",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.comp": {},
        "sap.ui.core": {},
        "sap.viz": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "code.d3.defect.analysis.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "chart": {
        "dataSource": "chartService",
        "preload": true,
        "settings": {}
      },
      "kpi": {                             
        "dataSource": "kpiService",
        "preload": true
      },
      "order": {
        "dataSource": "orderService",
        "preload": true
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "code.d3.defect.analysis.view",
        "async": true,
        "viewPath": "code.d3.defect.analysis.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteInspectionDetail",
          "pattern": "inspection/{inspectionNo}",
          "target": [
            "TargetInspectionDetail"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetInspectionDetail": {
          "id": "OrderDetail",
          "name": "OrderDetail"
        }
      }
    },
    "rootView": {
      "viewName": "code.d3.defect.analysis.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
