<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar">

    <fb:FilterBar
        id="orderFilterBar"
        useToolbar="false"
        search=".onSearch"
        showClearOnFB="true"
        clear=".onFilterClear">

        <fb:filterGroupItems>
            <fb:FilterGroupItem
                groupName="G1"
                name="AedatFrom"
                label="{i18n>lblAedatFrom}"
                visibleInFilterBar="true">
                <fb:control>
                    <DatePicker
                        id="dpAedatFrom"
                        placeholder="{i18n>phAedatFrom}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd" />
                </fb:control>
            </fb:FilterGroupItem>

            <fb:FilterGroupItem
                groupName="G1"
                name="AedatTo"
                label="{i18n>lblAedatTo}"
                visibleInFilterBar="true">
                <fb:control>
                    <DatePicker
                        id="dpAedatTo"
                        placeholder="{i18n>phAedatTo}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd" />
                </fb:control>
            </fb:FilterGroupItem>

            <fb:FilterGroupItem
                groupName="G1"
                name="Ordst"
                label="{i18n>lblOrdst}"
                visibleInFilterBar="true">
                <fb:control>
                    <MultiComboBox id="cbOrdst" placeholder="{i18n>phOrdst}">
                        <core:Item key="CLRQ" text="{i18n>itemClrq}" />
                        <core:Item key="TECO" text="{i18n>itemTeco}" />
                        <core:Item key="CLRJ" text="{i18n>itemClrj}" />
                    </MultiComboBox>
                </fb:control>
            </fb:FilterGroupItem>

            <fb:FilterGroupItem
                groupName="G1"
                name="Werks"
                label="{i18n>lblWerks}"
                visibleInFilterBar="true">
                <fb:control>
                    <ComboBox id="cbWerks" placeholder="{i18n>phWerks}">
                        <core:Item key="P00001" text="{i18n>itemP00001}" />
                        <core:Item key="P00002" text="{i18n>itemP00002}" />
                    </ComboBox>
                </fb:control>
            </fb:FilterGroupItem>

            <fb:FilterGroupItem
                groupName="G1"
                name="Aufnr"
                label="{i18n>colAufnr}"
                visibleInFilterBar="true">
                <fb:control>
                    <Input id="inAufnr" placeholder="{i18n>phAufnr}" showClearIcon="true"/>
                </fb:control>
            </fb:FilterGroupItem>
        </fb:filterGroupItems>
    </fb:FilterBar>
</core:FragmentDefinition>
