<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core">
    
    <Dialog 
        id="rejectDialog" 
        title="{i18n>titleRejectDialog}" 
        type="Message">
        
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="{i18n>labelRejectReason}" required="true"/>
                <TextArea
                    id="taRejectReason"
                    width="100%"
                    rows="4"
                    maxLength="50"
                    showExceededText="true"
                    liveChange=".onRejectReasonLiveChange"
                    placeholder="{i18n>placeholderRejectReason}"/>
            </VBox>
        </content>
        
        <beginButton>
            <Button text="{i18n>btnConfirmReject}" type="Reject" press=".onConfirmReject" />
        </beginButton>
        
        <endButton>
            <Button text="{i18n>btnCancel}" press=".onCancelReject" />
        </endButton>
        
    </Dialog>
</core:FragmentDefinition>
