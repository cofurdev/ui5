<mvc:View controllerName="code.d19.hw1c.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <content>
    <Panel
        headerText="{i18n>panelHeader}"
        class="sapUiResposiveMargin"
        width="auto" >
        <content>
        </content>
    </Panel>
    
    <!-- 1조 조원 정보를 다루는 sap.m.Table -->
    <Table
        id="memberTable"
        class="sapUiResposiveMargin"
        width="auto"
        items="{/Members}"
        mode="SingleSelectMaster"
        selectionChange=".onMemberChange">
        <headerToolbar>
            <Toolbar >
                <Title text="{i18n>toolbarText}" />
                <ToolbarSpacer />
                <SearchField 
                    width="50%"
                    search=".onFilterMember"
                    placeholder="{i18n>searchText}" />
            </Toolbar>
        </headerToolbar>

        <columns>
            <Column ><header><Text text="{i18n>name}" /></header></Column>
            <Column ><header><Text text="{i18n>birth}" /></header></Column>
            <Column ><header><Text text="{i18n>gender}" /></header></Column>
            <Column ><header><Text text="{i18n>phone}" /></header></Column>
            <Column ><header><Text text="{i18n>address}" /></header></Column>
            <Column ><header><Text text="{i18n>email}" /></header></Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <ObjectIdentifier title="{Name}" />
                    <Text text="{Birth}" />
                    <Text text="{
                        path:'Gender',
                        formatter:'.formatter.genderText'}" />
                    <Text text="{Phone}"/>
                    <Text text="{Address}"/>
                    <Text text="{Email}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>

    <!-- 선택한 조원의 구매 이력을 출력하는 sap.m.Table -->
    <Table 
        id="purchasesTable"
        headerText="{= ${Name} ? ${Name} : '1조 조원'}의 구매 이력" 
        items="{_Purchases}"
        growing="true"
        growingThreshold="2"
        class="sapUiResponsiveMargin"
        width="auto" >
        <columns>
            <Column ><header><Text text="{i18n>productName}"/></header></Column>
            <Column ><header><Text text="{i18n>type}"/></header></Column>
            <Column ><header><Text text="{i18n>price}"/></header></Column>
            <Column ><header><Text text="{i18n>store}"/></header></Column>
            <Column ><header><Text text="{i18n>purchaseDate}"/></header></Column>
            <Column ><header><Text text="{i18n>returned}"/></header></Column>
        </columns>
        <items>
            <ColumnListItem >
                <cells>
                    <ObjectIdentifier title="{Product_name}" />
                    <Text text="{
                        path:'Type',
                        formatter:'.formatter.typeText'}" />
                    <ObjectNumber 
                        number="{
                            parts: [ {path: 'Price'}, {path: 'Currency'} ],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: false}}"
                        unit="{Currency}" />
                    <Text text="{Store}" />
                    <Text text="{ path:'Purchase_date',
                                type:'sap.ui.model.type.Date',
                                formatOptions: {
                                    source:{ pattern: 'yyyy-MM-dd', style: 'medium' }
                                }}" />
                    <core:Icon src="{= ${Returned}==='O' ? 'sap-icon://circle-task' : 'sap-icon://decline'}" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
    </content>
    </Page>
</mvc:View>