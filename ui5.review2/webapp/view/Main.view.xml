<mvc:View controllerName="code.t3.ui5.review2.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form = "sap.ui.layout.form"
    >
    <!--sap.m.Page를 의미한다. -->
    <Page id="page" title="{i18n>title}">

    <!-- sap.ui.layout.form.SimpleForm를 의미한다. -->
        <form:SimpleForm
            layout="ResponsiveGridLayout"    
        >
            <form:toolbar>
                <Toolbar >
                    <Title text="신규" />
                    <ToolbarSpacer />
                    <!-- onSave 메서드는 Main.controller.js 파일에 정의되어 있어야 합니다.
                    이 메서드는 버튼이 눌렸을 때 실행될 함수를 지정합니다.-->
                    <Button
                        text="저장"
                        press=".onSave"
                    />
                    <!-- onReset 메서드는 Main.controller.js 파일에 정의되어 있어야 합니다.
                    이 메서드는 버튼이 눌렸을 때 실행될 함수를 지정합니다.-->
                    <Button 
                        text="초기화"
                        press=".onReset"
                    />
                </Toolbar>
            </form:toolbar>

            <form:content>
                <!-- sap.m.Label를 의미한다. -->
                <Label text = "이름"></Label>
                <!-- sap.m.Input를 의미한다. -->
                <Input value="{/name}"></Input>

                <!-- sap.m.Label를 의미한다. -->
                <Label text = "나이"></Label>
                <!-- sap.m.Input를 의미한다. -->
                <Input value="{/age}"></Input>

                <!-- sap.m.Label를 의미한다. -->
                <Label text = "주소"></Label>
                <!-- sap.m.Input를 의미한다. -->
                <Input value="{/city}"></Input>
            </form:content>
        </form:SimpleForm>

    </Page>
</mvc:View>