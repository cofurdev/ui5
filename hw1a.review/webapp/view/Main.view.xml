<mvc:View controllerName="code.d19.hw1a.review.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <!-- 소문자로 시작하는 것 바로 위 대문자로 시작하는 것의 속성, aggregation -->
        <content>
            <!-- labelFor를 통해 input의 id를 입력하면 그 input의 label이라고 지정이 됨 -->
            <!-- 보이는 데에는 차이가 없지만, labelFor를 활용하면 label을 클릭했을 때 입력필드로 커서가 이동함 -->
            <Label text="값을 입력하세요." labelFor="idInput"/>
            <!-- property binding value를 통해 완료 -->
            <Input id="idInput" value="{/Vlaue}"/>
            
            <Button text="출력" press="onClickButton" />
            <Button text="출력(JSON Model)" press="onClickJsonButton" />
       
        </content>

    </Page>
</mvc:View>