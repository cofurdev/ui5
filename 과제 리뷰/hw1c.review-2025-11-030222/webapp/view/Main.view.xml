<mvc:View controllerName="code.d00.hw1c.review.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

        <!-- 조원 목록 테이블 -->
        <Table
            id="idMemberTable"
            items="{member>/Member}"
            headerText="{i18n>memberTableTitle}"
            mode="SingleSelectLeft"
            selectionChange=".onSelectionChange"
        >
            <columns>
                <Column><Text text="{i18n>columnTextName}" /></Column>
                <Column><header><Text text="{i18n>columnTextGender}" /></header></Column>
                <Column><header><Text text="{i18n>columnTextAddress}" /></header></Column>
            </columns>
            <items>
                <ColumnListItem >
                    <ObjectIdentifier title="{member>Name}" />
                    <Text text="{member>Gender}" />
                    <Text text="{member>Address}" />
                </ColumnListItem>
            </items>
        </Table>

        <!-- 특정 조원의 상세 정보 -->
        <Table 
            id="idMemberDetailTable"
            items="{ path:'member>_Details',
                     sorter: [ { path: 'Type', group: true} ] }"
            headerText="{i18n>memberDetailTableTitle}"
        >
            <columns>   
                <Column><header><Text text="{i18n>columnTextMenu}" /></header></Column>
                <Column><header><Text text="{i18n>columnTextType}" /></header></Column>
                <Column><header><Text text="{i18n>columnTextDay}" /></header></Column>
                <Column><header><Text text="{i18n>columnTextPrice}" /></header></Column>
                <Column><header><Text text="{i18n>columnTextPlace}" /></header></Column>
            </columns>
            <items>
                <ColumnListItem >
                    <ObjectIdentifier title="{member>Menu}" />
                    <Text text="{member>Type}" />
                    <Text text="{member>Day}" />
                    <ObjectNumber
                        number="{ parts: [ { path: 'member>Price' }, 
                                           { path: 'member>Currency' } ],
                                  type: 'sap.ui.model.type.Currency',
                                  formatOptions: {
                                    showMeasure: false
                                  } }"
                        unit="{member>Currency}"
                    />
                    <Text text="{member>Place}" />
                </ColumnListItem>
            </items>
        </Table>

    </Page>
</mvc:View>