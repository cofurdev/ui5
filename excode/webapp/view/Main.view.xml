<mvc:View controllerName="code.d19.excode.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"        
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <Page id="page" title="{i18n>title}">
            <t:Table
                id= "idGridtable" 
                class="sapUiMediumMargin"
                rows="{ path: 'view>/Carriers',
                        parameters:{
                            expand: 'to_schedules'
                        } }"
            >
                <t:extension>
                    <OverflowToolbar>
                            <Title text="{i18n>tableTitle}"/>
                            <ToolbarSpacer />
                            <Button text="{i18n>buttonAdd}" press=".onAddButton"/>
                            <Button text="{i18n>buttonDelete}" press=".onDeleteButton"/>
                    </OverflowToolbar>
                </t:extension>
                
                <t:rowMode>
                    <rowmodes:Interactive rowCount="20" />
                </t:rowMode>

                <t:columns>
                    <!-- Carrier ID -->
                    <t:Column >
                        <t:label>
                            <Label text="{i18n>columnCarrierID}" />
                        </t:label>
                        <t:template>
                            <ObjectIdentifier title="{view>Carrid}"/>
                        </t:template>
                    </t:Column>
                    <!-- Carrier Name -->
                    <t:Column >
                        <t:label>
                            <Label text="{i18n>columnCarrierName}" />
                        </t:label>
                        <t:template>
                            <Text text="{view>Carrname}"/>
                        </t:template>
                    </t:Column>
                    <!-- Currency Code -->
                    <t:Column >
                        <t:label>
                            <Label text="{i18n>columnCurrencyCode}" />
                        </t:label>
                        <t:template>
                            <Text text="{view>Currcode}"/>  
                        </t:template>
                    </t:Column>
                    <!-- Carrier ID -->
                    <t:Column >
                        <t:label>
                            <Label text="{i18n>columnUrl}" />
                        </t:label>
                        <t:template>
                            <Text text="{view>Url}"/>
                        </t:template>
                    </t:Column>
                    <!-- Details Button -->
                    <t:Column hAlign="Center"
                    >
                        <t:label>
                            <Label text="{i18n>columnDetails}" />
                        </t:label>
                        <t:template>
                            <Button
                                id="idFlightInfoButton"
                                text="{i18n>buttonFlightInfo}"
                                press=".onDetailButton"
                                enabled="{= ${view>to_schedules/__list}.length > 0 ? true : false}" 
                                />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
    </Page>
</mvc:View>