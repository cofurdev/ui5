<mvc:View controllerName="code.d19.study1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes">

    <Page id="page" title="{i18n>title}">
        
        <t:Table
            id="idGridTable"
            class="sapUiMediumMargin"
            rows="{/Employees}"
        >
            <t:extension>
                <OverflowToolbar >
                    <Title text="직원 정보"/>
                    <ToolbarSpacer />
                    <Button text="조회" press=".onReadButton"/>
                </OverflowToolbar>
            </t:extension>

            <t:rowMode>
                <rowmodes:Interactive rowCount="10" />
            </t:rowMode>

            <t:columns>
                <!-- 직원ID -->
                <t:Column >
                    <t:label>
                        <Label text="{i18n>columnEmployeeID}" />
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{EmployeeID}"/>
                    </t:template>
                </t:Column>
                <!-- 이름 -->
                <t:Column >
                    <t:label>
                        <Label text="{i18n>columnFirstName}" />
                    </t:label>
                    <t:template>
                        <Text text="{FirstName}"/>
                    </t:template>
                </t:Column>
                <!-- 입사일 -->
                <t:Column >
                    <t:label>
                        <Label text="{i18n>columnHireDate}" />
                    </t:label>
                    <t:template>
                       <Text text="{
                             path: 'HireDate',
                             type: 'sap.ui.model.type.Date',
                             formatOptions:{
                                pattern:'yyy.MM.dd'        
                             }
                        }"/>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>


        
        <Table 
            class = "sapUiResponsiveMargin"
            width="auto"
            headerText="{i18n>tableTitle}"
            items="{/Employees}"
        >
            <columns>
                <Column ><Text text="{i18n>columnEmployeeID}"/></Column>
                <Column ><Text text="{i18n>columnFirstName}"/></Column>
                <Column ><Text text="{i18n>columnHireDate}"/></Column>            
            </columns>
            <items>
                <ColumnListItem type="Navigation" >
                    <ObjectIdentifier title="{EmployeeID}"/>
                    <Text text="{FirstName}"/>
                    <Text text="{
                            path: 'HireDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions:{
                                pattern:'yyy.MM.dd'        
                            }
                        }"/>                   
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>